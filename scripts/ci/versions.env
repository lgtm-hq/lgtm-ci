# dotenv-linter:off
# SPDX-License-Identifier: MIT
# scripts/ci/versions.env - the only place a supplier tool version lives (#1096).
#
# Every installer under scripts/ci sources this file and keeps its runtime
# `${VAR:-$DEFAULT_VAR}` override. Nothing here is executed: the file holds
# plain `DEFAULT_<TOOL>_...="..."` assignments and comments, so `source` is
# side-effect free and the Renovate regex manager (renovate.json,
# "Supplier tool pins and digests") can read it line by line. dotenv-linter is
# off for this file: its key ordering and quote rules would break the grammar
# below, which bash and Renovate both depend on.
#
# Grammar (enforced by tests/bats/unit/renovate/test_tool_pins.bats):
#
#   # renovate: datasource=<ds> depName=<name> [extractVersion=..] [versioning=..]
#   DEFAULT_<TOOL>_VERSION="<version>"
#
#   # renovate: datasource=github-release-attachments depName=<name> [versioning=..]
#   DEFAULT_<TOOL>_SHA256_<ASSET>="<sha256 hex>" # <release tag>
#
#   # renovate: datasource=github-tags depName=<name>
#   DEFAULT_<TOOL>_COMMIT="<commit sha>" # <tag>
#
# A digest line is a self-contained Renovate dependency: the trailing comment
# is the upstream release tag the digest was computed from, which is what the
# github-release-attachments datasource needs to map the asset into the next
# release (it calls releases/tags/<tag>). The version line and its digest
# lines share one Renovate branch (same depName), so a version bump and the
# matching digest refresh land in one PR. test_tool_pins.bats asserts every
# digest-line tag ends with the tool's DEFAULT_<TOOL>_VERSION, so the two can
# never drift silently.
#
# Digest-only updates (same version, new digest) mean the upstream asset was
# replaced in place. renovate.json never automerges those for this file.
#
# Regenerate or verify every digest with:
#   scripts/ci/maintenance/refresh-tool-digests.sh --check   (verify)
#   scripts/ci/maintenance/refresh-tool-digests.sh --write   (rewrite values)
#
# Bumping a version by hand: change DEFAULT_<TOOL>_VERSION, update every
# `# <tag>` comment on that tool's digest lines, then run --write.
#
# Remaining duplicates outside this file (YAML `with:` / `default:` pins that
# cannot read a file; each annotated once where it lives, every copy asserted
# equal by test_tool_pins.bats):
#   uv     .github/actions/setup-python/action.yml
#   bun    .github/actions/setup-node/action.yml, run-vitest, run-playwright,
#          run-lighthouse, reusable-test-node(-custom), reusable-test-e2e(-matrix,
#          -playwright), reusable-deploy-site-with-reports, reusable-site-quality
#   grype  .github/actions/scan-vulnerabilities/action.yml
#
# Not pinned here on purpose:
#   @lhci/cli  a consumer prerequisite since #1077/#1102; run-lighthouse.sh no
#              longer installs it, so there is nothing for lgtm-ci to pin.
#   tomlkit    installed by scripts/ci/release/ecosystems/{python,pep621}.sh with
#              a range pin; listed in unverified-installers.allowlist.

# --- osv-scanner (scripts/ci/security/install-osv-scanner.sh) -------------
# renovate: datasource=github-releases depName=google/osv-scanner
DEFAULT_OSV_SCANNER_VERSION="2.3.5"
# renovate: datasource=github-release-attachments depName=google/osv-scanner
DEFAULT_OSV_SCANNER_SHA256_LINUX_AMD64="bb30c580afe5e757d3e959f4afd08a4795ea505ef84c46962b9a738aa573b41b" # v2.3.5
# renovate: datasource=github-release-attachments depName=google/osv-scanner
DEFAULT_OSV_SCANNER_SHA256_LINUX_ARM64="fa46ad2b3954db5d5335303d45de921613393285d9a93c140b63b40e35e9ce50" # v2.3.5

