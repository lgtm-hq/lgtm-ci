DEFAULT_CLAUDE_CODE_VERSION="2.1.232"
# renovate: datasource=npm depName=@openai/codex
DEFAULT_CODEX_VERSION="0.147.0"
# Cursor publishes no registry feed; bump by hand with both checksums.
