# --- AI review CLIs (scripts/ci/actions/install-ai-review-cli.sh) ----------
# npm CLIs install from the committed lockfiles under scripts/ci/ai-review-cli/
# (integrity-pinned, Renovate npm manager). These lines are the same pins so
# the single source stays here; test_tool_pins.bats asserts they are equal.
