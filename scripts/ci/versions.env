# --- cargo-nextest (scripts/ci/testing/rust/setup-rust-nextest.sh) ---------
# Release tags are cargo-nextest-<version>; the version line strips the prefix
# and the digest lines keep the raw tag.
# renovate: datasource=github-releases depName=nextest-rs/nextest extractVersion=^cargo-nextest-(?<version>.+)$
DEFAULT_CARGO_NEXTEST_VERSION="0.9.92"
# renovate: datasource=github-release-attachments depName=nextest-rs/nextest versioning=regex:^cargo-nextest-(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)$
DEFAULT_CARGO_NEXTEST_SHA256_X86_64_UNKNOWN_LINUX_GNU="7d8fabc1b012075aab1b77c9462670e5ea34f9e40c6cf2c12a2ec2f9ee32bf20" # cargo-nextest-0.9.92
# renovate: datasource=github-release-attachments depName=nextest-rs/nextest versioning=regex:^cargo-nextest-(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)$
DEFAULT_CARGO_NEXTEST_SHA256_AARCH64_UNKNOWN_LINUX_GNU="6adc85b7ffebe5bc3c4f30127c047d4766f65ddca906e12731591ea1cc81e995" # cargo-nextest-0.9.92
# renovate: datasource=github-release-attachments depName=nextest-rs/nextest versioning=regex:^cargo-nextest-(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)$
DEFAULT_CARGO_NEXTEST_SHA256_UNIVERSAL_APPLE_DARWIN="9490f380ea0568d179423bb5028955f91690e58051a95be0eb15f0119bc3df7a" # cargo-nextest-0.9.92
# renovate: datasource=github-release-attachments depName=nextest-rs/nextest versioning=regex:^cargo-nextest-(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)$
DEFAULT_CARGO_NEXTEST_SHA256_X86_64_PC_WINDOWS_MSVC="e07391ea2bda51cb2ff26d536061723c7ea9e14adc69cd2ab9de44019bae7b03" # cargo-nextest-0.9.92

