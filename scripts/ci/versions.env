DEFAULT_OSV_SCANNER_SHA256_LINUX_AMD64="160c6253e2922e9e0a6a9771c5c4c40a4b3c6090b34a3cdd5e80c96cc2e4218b" # v2.7.0
# renovate: datasource=github-release-attachments depName=google/osv-scanner
DEFAULT_OSV_SCANNER_SHA256_LINUX_ARM64="4061ef4c021ed3c47f203b818f337e351336cc5cd67c0274fc36bd1dfc728dd7" # v2.7.0

