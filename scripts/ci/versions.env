# --- cargo-nextest (scripts/ci/testing/rust/setup-rust-nextest.sh) ---------
# Release tags are cargo-nextest-<version>; the version line strips the prefix
# and the digest lines keep the raw tag.
# renovate: datasource=github-releases depName=nextest-rs/nextest extractVersion=^cargo-nextest-(?<version>.+)$
DEFAULT_CARGO_NEXTEST_VERSION="0.9.150"
# renovate: datasource=github-release-attachments depName=nextest-rs/nextest versioning=regex:^cargo-nextest-(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)$
DEFAULT_CARGO_NEXTEST_SHA256_X86_64_UNKNOWN_LINUX_GNU="b0959bc64232974224cf9fb22c915845398c0e8668fa7831eb5b43fb1eef781f" # cargo-nextest-0.9.150
# renovate: datasource=github-release-attachments depName=nextest-rs/nextest versioning=regex:^cargo-nextest-(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)$
DEFAULT_CARGO_NEXTEST_SHA256_AARCH64_UNKNOWN_LINUX_GNU="9164568e9840c6509177086828ac7d3178c2d8feb0658b4d2bff62fa620e98c8" # cargo-nextest-0.9.150
# renovate: datasource=github-release-attachments depName=nextest-rs/nextest versioning=regex:^cargo-nextest-(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)$
DEFAULT_CARGO_NEXTEST_SHA256_UNIVERSAL_APPLE_DARWIN="82a759b4d218d38359424196ab244c470e8f7c7d149c814fbbeef4d67c3c301a" # cargo-nextest-0.9.150
# renovate: datasource=github-release-attachments depName=nextest-rs/nextest versioning=regex:^cargo-nextest-(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)$
DEFAULT_CARGO_NEXTEST_SHA256_X86_64_PC_WINDOWS_MSVC="b7a8bf567140b8b366716f2dea27b32e088dc12f53597315f976d0dbf7c6ade8" # cargo-nextest-0.9.150

