# --- cargo-nextest (scripts/ci/testing/rust/setup-rust-nextest.sh) ---------
# Release tags are cargo-nextest-<version>; the version line strips the prefix
# and the digest lines keep the raw tag.
# renovate: datasource=github-releases depName=nextest-rs/nextest extractVersion=^cargo-nextest-(?<version>.+)$
DEFAULT_CARGO_NEXTEST_VERSION="0.9.151"
# renovate: datasource=github-release-attachments depName=nextest-rs/nextest versioning=regex:^cargo-nextest-(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)$
DEFAULT_CARGO_NEXTEST_SHA256_X86_64_UNKNOWN_LINUX_GNU="1d4ce302b820c41f4b89c5fb9bce45f0f0c94882c1cf08fc360caf08be6e7df4" # cargo-nextest-0.9.151
# renovate: datasource=github-release-attachments depName=nextest-rs/nextest versioning=regex:^cargo-nextest-(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)$
DEFAULT_CARGO_NEXTEST_SHA256_AARCH64_UNKNOWN_LINUX_GNU="3e35e8f6913af92558ba09d7155f74e35dd1f0024ef3cd891637433ae4eacbdd" # cargo-nextest-0.9.151
# renovate: datasource=github-release-attachments depName=nextest-rs/nextest versioning=regex:^cargo-nextest-(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)$
DEFAULT_CARGO_NEXTEST_SHA256_UNIVERSAL_APPLE_DARWIN="d1d7d025d4bfc9fb154cd76aea3949bd78534829a0589abefa6e5dd4edb135dd" # cargo-nextest-0.9.151
# renovate: datasource=github-release-attachments depName=nextest-rs/nextest versioning=regex:^cargo-nextest-(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)$
DEFAULT_CARGO_NEXTEST_SHA256_X86_64_PC_WINDOWS_MSVC="e51bdb4b5883df48f335381b287378edb244318fac65ae0adaf6b9e69298246b" # cargo-nextest-0.9.151

