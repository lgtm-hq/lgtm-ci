# --- cargo-nextest (scripts/ci/testing/rust/setup-rust-nextest.sh) ---------
# Release tags are cargo-nextest-<version>; the version line strips the prefix
# and the digest lines keep the raw tag.
# renovate: datasource=github-releases depName=nextest-rs/nextest extractVersion=^cargo-nextest-(?<version>.+)$
DEFAULT_CARGO_NEXTEST_VERSION="0.9.148"
# renovate: datasource=github-release-attachments depName=nextest-rs/nextest versioning=regex:^cargo-nextest-(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)$
DEFAULT_CARGO_NEXTEST_SHA256_X86_64_UNKNOWN_LINUX_GNU="223ba936714cc861a9cdedad5a8eb664dfdd69d6fbdf6cea6aa8184f523290dc" # cargo-nextest-0.9.148
# renovate: datasource=github-release-attachments depName=nextest-rs/nextest versioning=regex:^cargo-nextest-(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)$
DEFAULT_CARGO_NEXTEST_SHA256_AARCH64_UNKNOWN_LINUX_GNU="81469eb963ef883fd590e60189e77d6aba3d91b418591d3391f50fe3e9480d2b" # cargo-nextest-0.9.148
# renovate: datasource=github-release-attachments depName=nextest-rs/nextest versioning=regex:^cargo-nextest-(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)$
DEFAULT_CARGO_NEXTEST_SHA256_UNIVERSAL_APPLE_DARWIN="6c23b7fb4ca82c571fc8dfedbab45bfa773d45918f933170c85d21cd7f4b852b" # cargo-nextest-0.9.148
# renovate: datasource=github-release-attachments depName=nextest-rs/nextest versioning=regex:^cargo-nextest-(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)$
DEFAULT_CARGO_NEXTEST_SHA256_X86_64_PC_WINDOWS_MSVC="bef17504bed9d4994cf860c122e84a90d613b92e6d89584fa9e28bd53ad42e15" # cargo-nextest-0.9.148

