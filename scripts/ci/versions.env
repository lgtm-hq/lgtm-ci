DEFAULT_CURSOR_AGENT_VERSION="2026.08.11-e8db854"
DEFAULT_CURSOR_AGENT_SHA256_X64="bfff4bf6f4e9dd30c1d0ef0a70b6077b074015dd2948e4c50685d53afdcfce5a"
DEFAULT_CURSOR_AGENT_SHA256_ARM64="ea13f92e295f523a99ce8d8f57d6894d21e5d1e2d030ffad718ccd5955ca2eed"

