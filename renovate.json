{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>lgtm-hq/.github:renovate-config"],
  "description": [
    "ignorePaths overrides Renovate's default list only to drop **/examples/**: the lgtm-ci self-reference manager (#765) must see examples/**, which the default silently excluded (#808). The remaining defaults are kept verbatim."
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track pinned py-lintro Docker image digests",
      "managerFilePatterns": [
        "/^\\.github/workflows/reusable-quality-lint\\.yml$/",
        "/^\\.github/workflows/reusable-security-audit\\.yml$/",
        "/^scripts/ci/quality/resolve-lintro-image\\.sh$/",
        "/^\\.github/actions/run-quality/action\\.yml$/",
        "/^README\\.md$/",
        "/^\\.github/actions/README\\.md$/"
      ],
      "matchStrings": [
        "ghcr\\.io/lgtm-hq/py-lintro@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "depNameTemplate": "ghcr.io/lgtm-hq/py-lintro",
      "currentValueTemplate": "latest",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Supplier tool pins and digests: scripts/ci/versions.env is the single source for every tool version installed by scripts/ci (#1096). Version lines bump the version; digest lines (sha256 of a release asset via github-release-attachments, or a tag commit via github-tags) carry the release tag as a trailing comment and bump version+digest together. Same depName => same branch, so one PR carries both.",
      "managerFilePatterns": ["/^scripts/ci/versions\\.env$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)(?:\\s+extractVersion=(?<extractVersion>\\S+))?(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\nDEFAULT_[A-Z0-9_]+_VERSION=\"(?<currentValue>v?[0-9]+(?:\\.[0-9]+){0,2})\"",
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)(?:\\s+extractVersion=(?<extractVersion>\\S+))?(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\nDEFAULT_[A-Z0-9_]+_(?:SHA256|COMMIT)[A-Z0-9_]*=\"(?<currentDigest>[a-f0-9]{40}|[a-f0-9]{64})\" # (?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{/if}}",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Track annotated YAML version pins (action defaults and with: values that cannot read versions.env; every copy is asserted equal by tests/bats/unit/renovate/test_tool_pins.bats)",
      "managerFilePatterns": [
        "/^\\.github/actions/setup-python/action\\.yml$/",
        "/^\\.github/actions/setup-node/action\\.yml$/",
        "/^\\.github/actions/run-vitest/action\\.yml$/",
        "/^\\.github/actions/run-playwright/action\\.yml$/",
        "/^\\.github/actions/run-lighthouse/action\\.yml$/",
        "/^\\.github/workflows/reusable-test-node\\.yml$/",
        "/^\\.github/workflows/reusable-test-node-custom\\.yml$/",
        "/^\\.github/workflows/reusable-test-e2e\\.yml$/",
        "/^\\.github/workflows/reusable-test-e2e-matrix\\.yml$/",
        "/^\\.github/workflows/reusable-test-e2e-playwright\\.yml$/",
        "/^\\.github/workflows/reusable-deploy-site-with-reports\\.yml$/",
        "/^\\.github/workflows/reusable-site-quality\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)(?:\\s+extractVersion=(?<extractVersion>\\S+))?(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n\\s*[A-Za-z0-9_-]+:\\s*\"(?<currentValue>v?[0-9]+(?:\\.[0-9]+){0,2})\""
      ],
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{/if}}",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Track pinned step-security/harden-runner SHAs outside workflows",
      "managerFilePatterns": [
        "/^scripts/ci/actions/validate-harden-runner-action-ref\\.sh$/",
        "/^tests/bats/integration/test_harden_runner_action_ref\\.bats$/",
        "/^tests/bats/integration/test_reusable_tooling_sparse_checkout\\.bats$/",
        "/^docs/actions/security\\.md$/",
        "/^docs/actions/README\\.md$/",
        "/^docs/workflow-contract\\.md$/",
        "/^examples/publish-python-release\\.yml$/"
      ],
      "matchStrings": [
        "step-security/harden-runner@(?<currentDigest>[a-f0-9]{40}) # v(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "HARDEN_SHA='(?<currentDigest>[a-f0-9]{40})' # v(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "step-security/harden-runner",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Track lgtm-ci self-references (uses: refs and tooling-ref) pinned in consumer-facing examples and onboarding docs (#765)",
      "managerFilePatterns": ["/^examples/.*\\.ya?ml$/", "/^docs/.*\\.md$/"],
      "matchStrings": [
        "lgtm-hq/lgtm-ci/\\.github/(?:workflows|actions)/[^@\\s]+@(?<currentDigest>[a-f0-9]{40}) # v(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "tooling-ref:\\s*\"?(?<currentDigest>[a-f0-9]{40})\"? # v(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "lgtm-hq/lgtm-ci",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Track pinned grype version in scan-vulnerabilities action (#865)",
      "managerFilePatterns": [
        "/^\\.github/actions/scan-vulnerabilities/action\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\s*\\n\\s*default: \"v(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "Group harden-runner SHA pins so workflow and non-workflow copies update together",
      "groupName": "step-security/harden-runner",
      "matchPackageNames": ["step-security/harden-runner"],
      "automerge": false
    },
    {
      "description": "Group lgtm-ci self-reference pins in examples/docs so every uses: and tooling-ref bump together (#765)",
      "groupName": "lgtm-ci example and docs pins",
      "matchPackageNames": ["lgtm-hq/lgtm-ci"],
      "automerge": false
    },
    {
      "description": "Group bun pins so the setup-node default and workflow setup-bun copies bump together",
      "groupName": "bun",
      "matchPackageNames": ["bun"],
      "automerge": false
    },
    {
      "description": "A digest-only change in versions.env means an upstream release asset or tag was replaced in place: a tamper signal, never automerged (#1096)",
      "matchFileNames": ["scripts/ci/versions.env"],
      "matchUpdateTypes": ["digest"],
      "automerge": false
    },
    {
      "description": "Group each AI review CLI's versions.env pin with its lockfile under scripts/ci/ai-review-cli so the two cannot drift (#1096)",
      "groupName": "ai-review-cli claude-code",
      "matchPackageNames": ["@anthropic-ai/claude-code"],
      "automerge": false
    },
    {
      "description": "Group each AI review CLI's versions.env pin with its lockfile under scripts/ci/ai-review-cli so the two cannot drift (#1096)",
      "groupName": "ai-review-cli codex",
      "matchPackageNames": ["@openai/codex"],
      "automerge": false
    }
  ]
}
