{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lgtm-hq/lgtm-ci/schemas/comment.v1.json",
  "title": "lgtm-ci comment model v1",
  "description": "The facts of one pull request comment, before layout (#1678). A renderer fills it; scripts/ci/lib/comment_format.py turns it into markdown for a comment-format (compact or table; classic is still each renderer's own markdown). Every string is raw text: the formatter sanitises it for the place it lands (docs/comment-sanitize.md), so no string here is markdown. The comment-fields block is not part of the model: the shared poster inserts it in the style the format names. v1 may add optional properties; it never removes or retypes one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "title",
    "status",
    "summary",
    "blocks",
    "facts",
    "links",
    "footer"
  ],
  "properties": {
    "schema": { "const": "comment.v1" },
    "kind": {
      "description": "Which comment this is, e.g. test-report; later coverage, lint, link-check.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["icon", "text"],
      "properties": {
        "icon": {
          "description": "Emoji before the title, written by lgtm-ci.",
          "type": "string",
          "maxLength": 8
        },
        "text": {
          "description": "Title text, e.g. the caller's suite name.",
          "$ref": "#/$defs/text"
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "emoji", "label"],
      "properties": {
        "level": {
          "description": "passed: a verified pass. Anything else opens compact's details by itself. Unreadable or missing results are never passed (#1692).",
          "enum": ["passed", "failed", "warning", "neutral"]
        },
        "emoji": { "type": "string", "maxLength": 8 },
        "label": {
          "description": "e.g. PASSED, FAILED, NO COUNTS.",
          "$ref": "#/$defs/text"
        }
      }
    },
    "summary": {
      "description": "The headline after the status, in groups joined by ' · '; the spans of a group are joined by ', '. Never a count that could not be read.",
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": { "$ref": "#/$defs/span" }
      }
    },
    "blocks": {
      "description": "The body in order: tables, notices and folded lists.",
      "type": "array",
      "maxItems": 32,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/table" },
          { "$ref": "#/$defs/notice" },
          { "$ref": "#/$defs/list" }
        ]
      }
    },
    "facts": {
      "description": "Labelled run facts (build, generated, commit). compact: one line in the details; table: extra columns of the table named by attach, or a table of their own.",
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/fact" }
    },
    "links": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": { "$ref": "#/$defs/text" },
          "long_label": {
            "description": "Label in a footer (table format).",
            "$ref": "#/$defs/text"
          },
          "url": { "$ref": "#/$defs/url" }
        }
      }
    },
    "footer": {
      "description": "Small print at the end, e.g. 'Generated by <suite> workflow'.",
      "$ref": "#/$defs/text"
    }
  },
  "$defs": {
    "text": { "type": "string", "maxLength": 4000 },
    "url": {
      "description": "Linked only when the sanitiser's link rules accept it.",
      "type": "string",
      "maxLength": 2048
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "$ref": "#/$defs/text" },
        "strong": { "type": "boolean" },
        "code": { "description": "Show as inline code.", "type": "boolean" }
      }
    },
    "cell": {
      "description": "Exactly one of text, count or link, with an optional emoji mark after it.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "text": { "$ref": "#/$defs/text" },
        "count": { "type": "integer", "minimum": 0, "maximum": 999999999 },
        "link": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "url"],
          "properties": {
            "label": { "$ref": "#/$defs/text" },
            "url": { "$ref": "#/$defs/url" }
          }
        },
        "mark": { "type": "string", "maxLength": 8 },
        "mark_in": {
          "description": "all (default): the mark shows in every format; table: only in the table format.",
          "enum": ["all", "table"]
        },
        "strong": { "type": "boolean" }
      },
      "oneOf": [
        {
          "required": ["text"],
          "not": {
            "anyOf": [{ "required": ["count"] }, { "required": ["link"] }]
          }
        },
        {
          "required": ["count"],
          "not": {
            "anyOf": [{ "required": ["text"] }, { "required": ["link"] }]
          }
        },
        {
          "required": ["link"],
          "not": {
            "anyOf": [{ "required": ["text"] }, { "required": ["count"] }]
          }
        }
      ]
    },
    "table": {
      "description": "Metric table. compact: a row-label column headed by title; table format: that column only when there are several rows, and long_label for the other headers when there is not.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "title", "columns", "rows"],
      "properties": {
        "type": { "const": "table" },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
        "title": { "$ref": "#/$defs/text" },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label"],
            "properties": {
              "label": { "$ref": "#/$defs/text" },
              "long_label": { "$ref": "#/$defs/text" },
              "align": { "enum": ["left", "right"] }
            }
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "cells"],
            "properties": {
              "label": { "$ref": "#/$defs/text" },
              "cells": {
                "type": "array",
                "maxItems": 16,
                "items": { "$ref": "#/$defs/cell" }
              }
            }
          }
        }
      }
    },
    "notice": {
      "description": "One paragraph, e.g. why no totals are shown or which value is unreadable.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "spans"],
      "properties": {
        "type": { "const": "notice" },
        "emoji": { "type": "string", "maxLength": 8 },
        "spans": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/span" }
        }
      }
    },
    "list": {
      "description": "A folded list of code: text items, e.g. expected failures and their reasons. The formatter caps each value and the list's size; every item not shown is counted in 'and N more'.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "summary", "items"],
      "properties": {
        "type": { "const": "list" },
        "summary": { "$ref": "#/$defs/text" },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code"],
            "properties": {
              "code": { "$ref": "#/$defs/text" },
              "text": { "$ref": "#/$defs/text" }
            }
          }
        },
        "more": {
          "description": "Items not in items.",
          "type": "integer",
          "minimum": 0,
          "maximum": 999999999
        },
        "note": {
          "description": "A line after the list.",
          "$ref": "#/$defs/text"
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": { "$ref": "#/$defs/text" },
        "value": { "$ref": "#/$defs/cell" },
        "colon": {
          "description": "compact: 'Label: value' instead of 'Label value'.",
          "type": "boolean"
        },
        "attach": {
          "description": "Id of the table this fact joins as a column in the table format.",
          "type": "string"
        }
      }
    }
  }
}
