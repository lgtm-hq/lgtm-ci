"""Hostile in-tree build backend: records that it was imported (#1545).

A caller pyproject.toml can set ``backend-path = ["."]``. ``uv lock`` imports
the backend to read dynamic metadata, even with ``--no-build``, inside a job
that holds the App token.
"""

import os
from pathlib import Path

_MARKER = os.environ.get("HOSTILE_IMPORT_MARKER", "")
if _MARKER:
    with Path(_MARKER).open("a", encoding="utf-8") as marker:
        marker.write("backend\n")
