#!/usr/bin/env bats
# SPDX-License-Identifier: MIT
# Purpose: Tests for scripts/ci/actions/wrap-lychee-report.sh

load "../../../helpers/common"

SCRIPT="${PROJECT_ROOT}/scripts/ci/actions/wrap-lychee-report.sh"

setup() {
	setup_temp_dir
	export REPORT="${BATS_TEST_TMPDIR}/lychee-report.md"
	export OUT="${BATS_TEST_TMPDIR}/wrapped.md"
}

teardown() {
	teardown_temp_dir
}

write_report() {
	local errors="$1"
	cat >"$REPORT" <<EOF
# Summary

| Status        | Count |
|---------------|-------|
| 🔍 Total      | 12    |
| ✅ Successful | $((12 - errors)) |
| 🚫 Errors     | ${errors}     |
EOF
}

run_wrap() {
	run env \
		LYCHEE_REPORT="$REPORT" \
		LYCHEE_OUTCOME="${OUTCOME:-success}" \
		PATHS="docs,README.md" \
		FILE_EXTENSIONS="md,html" \
		EXCLUDE_PATTERNS="localhost" \
		CHECK_EXTERNAL="${EXTERNAL:-true}" \
		TIMEOUT="10" \
		FAIL_ON_ERROR="true" \
		OUTPUT="$OUT" \
		bash "$SCRIPT"
}

@test "wrap-lychee-report: external on lists scope without in-repo-only note" {
	write_report 0
	EXTERNAL=true run_wrap

	assert_success
	assert_file_contains_literal "$OUT" "## 🔗 Link Check Report"
	assert_file_contains_literal "$OUT" "External link checks:** enabled"
	assert_file_contains_literal "$OUT" "docs,README.md"
	assert_file_contains_literal "$OUT" "<sub>Generated by lgtm-ci link-check workflow</sub>"
	run grep -F "only in-repository links" "$OUT"
	assert_failure
}

@test "wrap-lychee-report: external off says only in-repository links verified" {
	write_report 0
	EXTERNAL=false run_wrap

	assert_success
	assert_file_contains_literal "$OUT" "External link checks:** disabled"
	assert_file_contains_literal "$OUT" "only in-repository links were verified"
}

@test "wrap-lychee-report: zero errors reports PASSED with counts" {
	write_report 0
	run_wrap

	assert_success
	assert_file_contains_literal "$OUT" "### 📊 Status: ✅ PASSED"
	assert_file_contains_literal "$OUT" "**Links checked:** 12 | **Errors:** 0"
	assert_file_contains_literal "$OUT" "<details>"
	assert_file_contains_literal "$OUT" "| 🔍 Total      | 12    |"
}

@test "wrap-lychee-report: errors present reports FAILED with counts" {
	write_report 3
	OUTCOME=failure run_wrap

	assert_success
	assert_file_contains_literal "$OUT" "### 📊 Status: ❌ FAILED"
	assert_file_contains_literal "$OUT" "**Errors:** 3"
}

@test "wrap-lychee-report: errors in report fail status even when step succeeded" {
	write_report 2
	OUTCOME=success run_wrap

	assert_success
	assert_file_contains_literal "$OUT" "Status: ❌ FAILED"
}

@test "wrap-lychee-report: report without counts falls back gracefully" {
	printf '# Summary\n\nNothing parseable here\n' >"$REPORT"
	run_wrap

	assert_success
	assert_file_contains_literal "$OUT" "Status: ✅ PASSED"
	assert_file_contains_literal "$OUT" "counts were not found"
}

@test "wrap-lychee-report: missing input file emits no-report body" {
	rm -f "$REPORT"
	OUTCOME=skipped run_wrap

	assert_success
	assert_file_contains_literal "$OUT" "## 🔗 Link Check Report"
	assert_file_contains_literal "$OUT" "NO REPORT PRODUCED"
	assert_file_contains_literal "$OUT" "skipped"
	run grep -F "<details>" "$OUT"
	assert_failure
}

@test "wrap-lychee-report: backticks and command substitution pass through literally" {
	cat >"$REPORT" <<'EOF'
# Summary

| 🔍 Total | 1 |
| 🚫 Errors | 1 |

* `code` and $(touch /tmp/should-not-exist-wrap-lychee) and `id`
EOF
	rm -f /tmp/should-not-exist-wrap-lychee
	OUTCOME=failure run_wrap

	assert_success
	assert_file_contains_literal "$OUT" '`code` and $(touch /tmp/should-not-exist-wrap-lychee) and `id`'
	[ ! -e /tmp/should-not-exist-wrap-lychee ]
}

@test "wrap-lychee-report: can overwrite its own input file" {
	write_report 1
	run env \
		LYCHEE_REPORT="$REPORT" \
		LYCHEE_OUTCOME=failure \
		OUTPUT="$REPORT" \
		bash "$SCRIPT"

	assert_success
	assert_file_contains_literal "$REPORT" "Status: ❌ FAILED"
	assert_file_contains_literal "$REPORT" "| 🚫 Errors     | 1     |"
}

@test "wrap-lychee-report: prints to stdout when OUTPUT is unset" {
	write_report 0
	run env LYCHEE_REPORT="$REPORT" LYCHEE_OUTCOME=success bash "$SCRIPT"

	assert_success
	assert_output --partial "Status: ✅ PASSED"
}
