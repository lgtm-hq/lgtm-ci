#!/usr/bin/env bats
# SPDX-License-Identifier: MIT
# Purpose: Tests for scripts/ci/actions/compose-artifact-report-comment.sh

load "../../../helpers/common"

SCRIPT="${PROJECT_ROOT}/scripts/ci/actions/compose-artifact-report-comment.sh"

setup() {
	setup_temp_dir
	export COMMENT_OUTPUT="${BATS_TEST_TMPDIR}/comment.md"
	export REPORT="${BATS_TEST_TMPDIR}/report.md"
	printf '| Check | Result |\n| --- | --- |\n| lint | ok |\n' >"$REPORT"
}

teardown() {
	teardown_temp_dir
}

run_report() {
	run env \
		REPORT_FILE="$REPORT" \
		TITLE="Validation" \
		COMMENT_OUTPUT="$COMMENT_OUTPUT" \
		"$@" \
		bash "$SCRIPT"
}

@test "compose-artifact-report: wraps report between heading and footer" {
	run_report
	assert_success
	assert_equal "$(head -n 1 "$COMMENT_OUTPUT")" "## Validation"
	assert_file_contains_literal "$COMMENT_OUTPUT" "| lint | ok |"
	assert_equal "$(tail -n 1 "$COMMENT_OUTPUT")" "<sub>Generated by lgtm-ci workflow</sub>"
}

@test "compose-artifact-report: no UPSTREAM_RESULT means no status line" {
	run_report
	assert_success
	run grep -F "Status:" "$COMMENT_OUTPUT"
	assert_failure
}

@test "compose-artifact-report: success renders PASSED" {
	run_report UPSTREAM_RESULT=success
	assert_success
	assert_file_contains_literal "$COMMENT_OUTPUT" "### 📊 Status: ✅ PASSED"
}

@test "compose-artifact-report: failure renders FAILED" {
	run_report UPSTREAM_RESULT=failure
	assert_success
	assert_file_contains_literal "$COMMENT_OUTPUT" "### 📊 Status: ❌ FAILED"
}

@test "compose-artifact-report: cancelled and skipped render skip marker" {
	run_report UPSTREAM_RESULT=cancelled
	assert_success
	assert_file_contains_literal "$COMMENT_OUTPUT" "### 📊 Status: ⏭️"
	run_report UPSTREAM_RESULT=skipped
	assert_success
	assert_file_contains_literal "$COMMENT_OUTPUT" "### 📊 Status: ⏭️"
}

@test "compose-artifact-report: WORKFLOW_NAME feeds the footer" {
	run_report WORKFLOW_NAME="Docs CI"
	assert_success
	assert_equal "$(tail -n 1 "$COMMENT_OUTPUT")" "<sub>Generated by Docs CI workflow</sub>"
}

@test "compose-artifact-report: report content is emitted literally" {
	printf '`id` and $(touch %s/pwned)\n' "$BATS_TEST_TMPDIR" >"$REPORT"
	run_report
	assert_success
	assert_file_contains_literal "$COMMENT_OUTPUT" '$(touch'
	[[ ! -e "${BATS_TEST_TMPDIR}/pwned" ]]
}

@test "compose-artifact-report: missing report warns and writes empty body" {
	rm -f "$REPORT"
	run_report
	assert_success
	assert_output --partial "::warning::"
	assert_file_exists "$COMMENT_OUTPUT"
	[[ ! -s "$COMMENT_OUTPUT" ]]
}

@test "compose-artifact-report: empty report writes empty body" {
	: >"$REPORT"
	run_report
	assert_success
	[[ ! -s "$COMMENT_OUTPUT" ]]
}

@test "compose-artifact-report: missing TITLE errors" {
	run env -u TITLE REPORT_FILE="$REPORT" COMMENT_OUTPUT="$COMMENT_OUTPUT" \
		bash "$SCRIPT"
	assert_failure
	assert_output --partial "::error::"
}

@test "compose-artifact-report: prints to stdout when COMMENT_OUTPUT unset" {
	run env -u COMMENT_OUTPUT REPORT_FILE="$REPORT" TITLE="Validation" \
		bash "$SCRIPT"
	assert_success
	assert_output --partial "## Validation"
}

@test "compose-artifact-report: RAW posts the report without the frame, through markdown mode (#1676)" {
	printf '## Own heading\n<!-- lgtm-ci:history:start -->\n@org/team **x**\n' >"$REPORT"
	run env REPORT_FILE="$REPORT" RAW="true" COMMENT_OUTPUT="$COMMENT_OUTPUT" bash "$SCRIPT"
	assert_success
	run cat "$COMMENT_OUTPUT"
	assert_line --index 0 "## Own heading"
	assert_line --index 2 "@org/team **x**"
	refute_output --partial "Generated by"
	refute_output --partial "<!-- lgtm-ci:"
}

@test "compose-artifact-report: RAW with SANITIZE_MODE=report breaks mentions, HTML and unsafe links (#1676)" {
	printf '## Own heading\n@org/team <img src=x> [x](javascript:alert(1)) fixes #1\n' >"$REPORT"
	run env REPORT_FILE="$REPORT" RAW="true" SANITIZE_MODE="report" COMMENT_OUTPUT="$COMMENT_OUTPUT" \
		bash "$SCRIPT"
	assert_success
	# The text stays; a zero-width space after @, <, ] and # leaves nothing live.
	run grep -c -e "@org" -e "<img" -e "](javascript" -e "#1" "$COMMENT_OUTPUT"
	assert_output "0"
	assert_file_contains_literal "$COMMENT_OUTPUT" "## Own heading"
	assert_file_contains_literal "$COMMENT_OUTPUT" "javascript:alert(1)) fixes #"
}

@test "compose-artifact-report: an unknown SANITIZE_MODE fails (#1676)" {
	run_report SANITIZE_MODE="fence"
	assert_failure
	assert_output --partial "SANITIZE_MODE must be markdown or report"
}

@test "compose-artifact-report: RAW with a missing report writes an empty body (#1676)" {
	run env REPORT_FILE="${BATS_TEST_TMPDIR}/absent.md" RAW="true" COMMENT_OUTPUT="$COMMENT_OUTPUT" \
		bash "$SCRIPT"
	assert_success
	assert [ ! -s "$COMMENT_OUTPUT" ]
}

@test "compose-artifact-report: a report file that is also the output is not truncated (#1676)" {
	local same="${BATS_TEST_TMPDIR}/artifact-report-comment.md"
	printf '## Mine\n\n| Check | Result |\n| --- | --- |\n| lint | ok |\n' >"$same"

	run env REPORT_FILE="$same" COMMENT_OUTPUT="$same" RAW="true" bash "$SCRIPT"
	assert_success
	assert_file_contains "$same" "## Mine"
	assert_file_contains_literal "$same" "| lint | ok |"

	# The framed form reads the report after the heading is written.
	printf '| Check | Result |\n| --- | --- |\n| lint | ok |\n' >"$same"
	run env REPORT_FILE="$same" COMMENT_OUTPUT="$same" TITLE="Report" bash "$SCRIPT"
	assert_success
	assert_file_contains_literal "$same" "| lint | ok |"
	# No temporary file is left beside the output.
	run bash -c 'ls "$1".* 2>/dev/null | wc -l' _ "$same"
	assert_output --regexp '^ *0$'
}
