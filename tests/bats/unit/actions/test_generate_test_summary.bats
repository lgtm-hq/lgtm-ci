#!/usr/bin/env bats
# SPDX-License-Identifier: MIT
# Purpose: Tests for scripts/ci/actions/generate-test-summary.sh

load "../../../helpers/common"

setup() {
	setup_temp_dir
}

teardown() {
	teardown_temp_dir
}

@test "generate-test-summary: uses unified report style with build metadata" {
	run env \
		TESTS_PASSED="10" \
		TESTS_FAILED="0" \
		TESTS_TOTAL="10" \
		TESTS_SKIPPED="0" \
		COVERAGE_ENABLED="true" \
		COVERAGE_PERCENT="91" \
		COVERAGE_THRESHOLD="80" \
		JOB_RESULT="success" \
		GITHUB_SERVER_URL="https://github.com" \
		GITHUB_REPOSITORY="lgtm-hq/lgtm-ci" \
		GITHUB_RUN_ID="12345" \
		GITHUB_SHA="abc123" \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-test-summary.sh"

	assert_success
	assert_output --partial "Shell Tests Report"
	assert_output --partial "reusable test workflow"
	assert_output --partial "Status: ✅ PASSED"
	assert_output --partial "Coverage:"
	assert_output --partial "Test Results"
	assert_output --partial "Code Coverage"
	assert_output --partial "View full build details"
	assert_output --partial "Generated by Shell Tests workflow"
}

@test "generate-test-summary: supports custom suite names and file output" {
	local comment_file="$BATS_TEST_TMPDIR/comment.md"

	run env \
		TEST_SUITE_NAME="Python Tests" \
		TESTS_PASSED="7" \
		TESTS_FAILED="0" \
		TESTS_TOTAL="7" \
		COVERAGE_ENABLED="true" \
		COVERAGE_PERCENT="88" \
		COVERAGE_THRESHOLD="80" \
		JOB_RESULT="success" \
		COMMENT_OUTPUT="$comment_file" \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-test-summary.sh"

	assert_success
	assert_file_exists "$comment_file"
	assert_file_contains "$comment_file" "Python Tests Report"
	assert_file_contains "$comment_file" "Generated by Python Tests workflow"
}

@test "generate-test-summary: reports passed when job succeeded without parsed counts" {
	run env \
		TESTS_PASSED="0" \
		TESTS_FAILED="0" \
		TESTS_TOTAL="0" \
		COVERAGE_ENABLED="false" \
		JOB_RESULT="success" \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-test-summary.sh"

	assert_success
	assert_output --partial "Status: ✅ PASSED"
	refute_output --partial "UNKNOWN"
}

@test "generate-test-summary: omits coverage sections when coverage is disabled" {
	run env \
		TESTS_PASSED="108" \
		TESTS_FAILED="0" \
		TESTS_TOTAL="108" \
		COVERAGE_ENABLED="false" \
		JOB_RESULT="success" \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-test-summary.sh"

	assert_success
	assert_output --partial "Status: ✅ PASSED"
	assert_output --partial "Test Results"
	assert_output --partial "Run Details"
	refute_output --partial "Unable to retrieve coverage"
	refute_output --partial "Code Coverage"
	refute_output --partial "Coverage Details"
	refute_output --partial "**Coverage:**"
	refute_output --partial "⚠️ N/A"
}

@test "generate-test-summary: defaults to omitting coverage when COVERAGE_ENABLED unset" {
	run env \
		TESTS_PASSED="5" \
		TESTS_FAILED="0" \
		TESTS_TOTAL="5" \
		JOB_RESULT="success" \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-test-summary.sh"

	assert_success
	refute_output --partial "Unable to retrieve coverage"
	refute_output --partial "Code Coverage"
}

@test "generate-test-summary: warns when coverage enabled but percent missing" {
	run env \
		TESTS_PASSED="10" \
		TESTS_FAILED="0" \
		TESTS_TOTAL="10" \
		COVERAGE_ENABLED="true" \
		JOB_RESULT="success" \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-test-summary.sh"

	assert_success
	assert_output --partial "Unable to retrieve coverage: coverage report was not generated."
	assert_output --partial "Code Coverage"
	assert_output --partial "⚠️ N/A"
}

@test "generate-test-summary: reports skipped coverage when tests failed" {
	run env \
		TESTS_PASSED="8" \
		TESTS_FAILED="2" \
		TESTS_TOTAL="10" \
		COVERAGE_ENABLED="true" \
		JOB_RESULT="failure" \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-test-summary.sh"

	assert_success
	assert_output --partial "Status: ❌ FAILED"
	assert_output --partial "Unable to retrieve coverage: coverage collection was skipped because tests failed."
}

@test "generate-test-summary: reports below-target coverage when under threshold" {
	run env \
		TESTS_PASSED="10" \
		TESTS_FAILED="0" \
		TESTS_TOTAL="10" \
		COVERAGE_ENABLED="true" \
		COVERAGE_PERCENT="79" \
		COVERAGE_THRESHOLD="80" \
		JOB_RESULT="failure" \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-test-summary.sh"

	assert_success
	assert_output --partial "Below target (<80%)"
	assert_output --partial "79%"
	assert_output --partial "Code Coverage"
}

@test "generate-test-summary: warns when percent set but coverage disabled" {
	run env \
		TESTS_PASSED="5" \
		TESTS_FAILED="0" \
		TESTS_TOTAL="5" \
		COVERAGE_ENABLED="false" \
		COVERAGE_PERCENT="90" \
		JOB_RESULT="success" \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-test-summary.sh"

	assert_success
	assert_output --partial "COVERAGE_PERCENT is set but COVERAGE_ENABLED=false"
	refute_output --partial "Code Coverage"
	refute_output --partial "**Coverage:**"
}

@test "generate-test-summary: blank line between Build and Coverage when enabled" {
	run env \
		TESTS_PASSED="10" \
		TESTS_FAILED="0" \
		TESTS_TOTAL="10" \
		COVERAGE_ENABLED="true" \
		COVERAGE_PERCENT="91" \
		COVERAGE_THRESHOLD="80" \
		JOB_RESULT="success" \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-test-summary.sh"

	assert_success
	assert_output --regexp $'\*\*Build:\*\* ✅ Tests passed\n\n\*\*Coverage:\*\*'
}

@test "generate-test-summary: writes the totals line as history-summary (#1346)" {
	local output_file="$BATS_TEST_TMPDIR/github_output"
	: >"$output_file"

	run env \
		TESTS_PASSED="42" \
		TESTS_FAILED="1" \
		TESTS_TOTAL="45" \
		TESTS_SKIPPED="2" \
		COVERAGE_ENABLED="true" \
		COVERAGE_PERCENT="91.2" \
		JOB_RESULT="failure" \
		GITHUB_OUTPUT="$output_file" \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-test-summary.sh"

	assert_success
	run cat "$output_file"
	assert_output "history-summary=42 passed, 1 failed, 2 skipped · 91.2% cov"
}

@test "generate-test-summary: history-summary omits coverage when not requested" {
	local output_file="$BATS_TEST_TMPDIR/github_output"
	: >"$output_file"

	run env \
		TESTS_PASSED="3" \
		TESTS_FAILED="0" \
		TESTS_TOTAL="3" \
		COVERAGE_PERCENT="80" \
		JOB_RESULT="success" \
		GITHUB_OUTPUT="$output_file" \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-test-summary.sh"

	assert_success
	run cat "$output_file"
	assert_output "history-summary=3 passed, 0 failed"
}

@test "generate-test-summary: populated counts keep the metrics table and pass rate (#1371)" {
	run env \
		TESTS_PASSED="9" TESTS_FAILED="1" TESTS_TOTAL="10" JOB_RESULT="failure" \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-test-summary.sh"

	assert_success
	assert_output --partial "| **Total Tests** | 10 |"
	assert_output --partial "| **Pass Rate** | 90% |"
	refute_output --partial "No test counts were parsed"
}

@test "generate-test-summary: no parsed counts omits the table and says so (#1371)" {
	local output_file="$BATS_TEST_TMPDIR/github_output"
	: >"$output_file"

	run env \
		RESULTS_PARSE_STATUS="missing" JOB_RESULT="success" \
		COVERAGE_ENABLED="true" COVERAGE_PERCENT="85" COVERAGE_THRESHOLD="80" \
		GITHUB_SERVER_URL="https://github.com" GITHUB_REPOSITORY="lgtm-hq/lgtm-ci" \
		GITHUB_RUN_ID="12345" GITHUB_OUTPUT="$output_file" \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-test-summary.sh"

	assert_success
	assert_output --partial "No test counts were parsed for this run (see the job log)"
	refute_output --partial "Total Tests"
	refute_output --partial "Pass Rate"
	assert_output --partial "Status:"
	assert_output --partial "Code Coverage"
	assert_output --partial "View full build details"
	run cat "$output_file"
	assert_output "history-summary=no counts · 85% cov"
}

@test "generate-test-summary: zero tests on a green job is NO TESTS without a pass rate (#1371)" {
	local output_file="$BATS_TEST_TMPDIR/github_output"
	: >"$output_file"

	run env \
		TESTS_PASSED="0" TESTS_FAILED="0" TESTS_TOTAL="0" JOB_RESULT="success" \
		GITHUB_OUTPUT="$output_file" \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-test-summary.sh"

	assert_success
	assert_output --partial "Status: ⚠️ NO TESTS"
	refute_output --partial "PASSED"
	assert_output --partial "| **Total Tests** | 0 |"
	refute_output --partial "Pass Rate"
	run cat "$output_file"
	assert_output "history-summary=0 tests"
}

@test "generate-test-summary: failure with zero counts stays FAILED (#1371)" {
	run env \
		TESTS_PASSED="0" TESTS_FAILED="0" TESTS_TOTAL="0" JOB_RESULT="failure" \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-test-summary.sh"

	assert_success
	assert_output --partial "Status: ❌ FAILED"
	refute_output --partial "NO TESTS"
}
