#!/usr/bin/env bats
# SPDX-License-Identifier: MIT
# Purpose: Tests for scripts/ci/actions/generate-playwright-comment.sh

load "../../../helpers/common"

setup() {
	setup_temp_dir
	export GITHUB_OUTPUT="${BATS_TEST_TMPDIR}/github-output"
	touch "$GITHUB_OUTPUT"
}

teardown() {
	teardown_temp_dir
}

@test "generate-playwright-comment: uses unified report style and failed details" {
	local results_file="${BATS_TEST_TMPDIR}/results.json"
	cat >"$results_file" <<'EOF'
{
  "stats": {
    "expected": 2,
    "unexpected": 1,
    "flaky": 1,
    "skipped": 1,
    "duration": 12345
  },
  "suites": [
    {
      "tests": [
        {"title": "checkout fails gracefully", "status": "failed"}
      ]
    }
  ]
}
EOF

	run env \
		GITHUB_OUTPUT="$GITHUB_OUTPUT" \
		RESULTS_PATH="$results_file" \
		REPORT_URL="https://example.com/playwright/" \
		SHOW_FAILED="true" \
		MAX_FAILED="5" \
		GITHUB_SERVER_URL="https://github.com" \
		GITHUB_REPOSITORY="lgtm-hq/lgtm-ci" \
		GITHUB_RUN_ID="12345" \
		GITHUB_SHA="abc123" \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-playwright-comment.sh"

	assert_success
	assert_file_contains "$GITHUB_OUTPUT" "total=5"
	assert_file_contains "$GITHUB_OUTPUT" "passed=2"
	assert_file_contains "$GITHUB_OUTPUT" "failed=1"
	assert_file_contains "$GITHUB_OUTPUT" "skipped=1"
	assert_file_contains "$GITHUB_OUTPUT" "success=false"
	assert_file_contains "$GITHUB_OUTPUT" "Playwright E2E Test Report"
	assert_file_contains "$GITHUB_OUTPUT" "Playwright E2E test workflow"
	assert_file_contains "$GITHUB_OUTPUT" "Status: ❌ FAILED"
	assert_file_contains "$GITHUB_OUTPUT" "Test Results"
	assert_file_contains "$GITHUB_OUTPUT" "checkout fails gracefully"
	assert_file_contains "$GITHUB_OUTPUT" "View Playwright HTML Report"
	assert_file_contains "$GITHUB_OUTPUT" "View full build details"
	assert_file_contains "$GITHUB_OUTPUT" "Generated by lgtm-ci Playwright E2E workflow"
}

@test "generate-playwright-comment: emits styled missing-results body" {
	run env \
		GITHUB_OUTPUT="$GITHUB_OUTPUT" \
		RESULTS_PATH="${BATS_TEST_TMPDIR}/missing.json" \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-playwright-comment.sh"

	assert_success
	assert_file_contains "$GITHUB_OUTPUT" "total=0"
	assert_file_contains "$GITHUB_OUTPUT" "passed=0"
	assert_file_contains "$GITHUB_OUTPUT" "failed=0"
	assert_file_contains "$GITHUB_OUTPUT" "skipped=0"
	assert_file_contains "$GITHUB_OUTPUT" "success=false"
	assert_file_contains "$GITHUB_OUTPUT" "Playwright E2E Test Report"
	assert_file_contains "$GITHUB_OUTPUT" "Status: ⚠️ MISSING"
	assert_file_contains "$GITHUB_OUTPUT" "No Playwright results found"
}

# --- native Playwright JSON reports (#1516) ---------------------------------

_generate() {
	run env GITHUB_OUTPUT="$GITHUB_OUTPUT" RESULTS_PATH="$1" SHOW_FAILED="true" MAX_FAILED="${2:-10}" \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-playwright-comment.sh"
	assert_success
}

@test "generate-playwright-comment: a native report lists its unexpected tests by spec and project" {
	# json-mixed: one each of expected, unexpected, flaky, skipped.
	_generate "${PROJECT_ROOT}/tests/fixtures/playwright/reports/json-mixed.json"
	assert_file_contains "$GITHUB_OUTPUT" "total=4"
	assert_file_contains "$GITHUB_OUTPUT" "passed=1"
	assert_file_contains "$GITHUB_OUTPUT" "failed=1"
	assert_file_contains "$GITHUB_OUTPUT" "skipped=1"
	assert_file_contains_literal "$GITHUB_OUTPUT" "Failed Tests (showing up to 10)"
	assert_file_contains_literal "$GITHUB_OUTPUT" "failing.spec.js › fails on purpose [chromium]"
	# Flaky has its own row, not the failed list.
	assert_file_contains_literal "$GITHUB_OUTPUT" "| **Flaky** | 1 |"
	run grep -c "flaky on purpose" "$GITHUB_OUTPUT"
	assert_output "0"
}

@test "generate-playwright-comment: a fractional stats.duration is shown in seconds" {
	# stats.duration 117018.533 ms
	_generate "${PROJECT_ROOT}/tests/fixtures/playwright/reports/json-fractional-duration.json"
	assert_file_contains_literal "$GITHUB_OUTPUT" "| **Duration** | 117s |"
}

@test "generate-playwright-comment: without stats, native statuses in suites are counted" {
	local results_file="${BATS_TEST_TMPDIR}/no-stats.json"
	jq 'del(.stats)' "${PROJECT_ROOT}/tests/fixtures/playwright/reports/json-mixed.json" >"$results_file"
	_generate "$results_file"
	assert_file_contains "$GITHUB_OUTPUT" "total=4"
	assert_file_contains "$GITHUB_OUTPUT" "passed=1"
	assert_file_contains "$GITHUB_OUTPUT" "failed=1"
	assert_file_contains "$GITHUB_OUTPUT" "skipped=1"
	assert_file_contains_literal "$GITHUB_OUTPUT" "| **Flaky** | 1 |"
	assert_file_contains "$GITHUB_OUTPUT" "success=false"
}

@test "generate-playwright-comment: without stats, tests outside suites are not counted" {
	local results_file="${BATS_TEST_TMPDIR}/config-tests.json"
	jq 'del(.stats) | .config.metadata.tests = [{"status": "unexpected", "title": "not a result"}]' \
		"${PROJECT_ROOT}/tests/fixtures/playwright/reports/json-passing.json" >"$results_file"
	_generate "$results_file"
	assert_file_contains "$GITHUB_OUTPUT" "failed=0"
	assert_file_contains "$GITHUB_OUTPUT" "success=true"
}

@test "generate-playwright-comment: the failed list stops at max-failed-tests" {
	local results_file="${BATS_TEST_TMPDIR}/many.json"
	jq '.suites[0].specs = [range(0; 4) as $i | {title: "t\($i)", file: "a.spec.js", tests: [{projectName: "chromium", status: "unexpected"}]}]
		| .stats += {expected: 0, unexpected: 4, flaky: 0, skipped: 0}' \
		"${PROJECT_ROOT}/tests/fixtures/playwright/reports/json-mixed.json" >"$results_file"
	_generate "$results_file" 2
	assert_file_contains_literal "$GITHUB_OUTPUT" "a.spec.js › t0 [chromium]"
	assert_file_contains_literal "$GITHUB_OUTPUT" "a.spec.js › t1 [chromium]"
	run grep -c "a.spec.js › t[23]" "$GITHUB_OUTPUT"
	assert_output "0"
}

@test "generate-playwright-comment: a non-numeric max-failed-tests warns and uses 10" {
	run env GITHUB_OUTPUT="$GITHUB_OUTPUT" SHOW_FAILED="true" MAX_FAILED="ten" \
		RESULTS_PATH="${PROJECT_ROOT}/tests/fixtures/playwright/reports/json-mixed.json" \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-playwright-comment.sh"
	assert_success
	assert_output --partial "::warning title=Playwright comment::max-failed-tests must be a whole number"
	assert_file_contains_literal "$GITHUB_OUTPUT" "failing.spec.js › fails on purpose [chromium]"
}

@test "generate-playwright-comment: the duration rounds half-up like the results parser" {
	# stats.duration 1499.5 ms -> 1500 ms -> 2 s (parse_playwright_json agrees).
	_generate "${PROJECT_ROOT}/tests/fixtures/playwright/reports/json-half-millisecond.json"
	assert_file_contains_literal "$GITHUB_OUTPUT" "| **Duration** | 2s |"
}

@test "generate-playwright-comment: unreadable stats never read as a pass (#1676)" {
	local results_file="${BATS_TEST_TMPDIR}/results.json"
	cat >"$results_file" <<'EOF'
{"stats": {"expected": "3 | @org/team |", "unexpected": -2, "flaky": 1.5,
  "skipped": "ordinary label", "timedOut": 0, "interrupted": 99999999999, "duration": "slow"},
 "suites": []}
EOF
	run env GITHUB_OUTPUT="$GITHUB_OUTPUT" RESULTS_PATH="$results_file" SHOW_FAILED="false" \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-playwright-comment.sh"
	assert_success
	assert_output --partial "::warning::The report's stats.expected value is not a number"
	assert_output --partial "::warning::The report's stats.interrupted value is not a number"
	assert_file_contains "$GITHUB_OUTPUT" "success=false"
	assert_file_contains_literal "$GITHUB_OUTPUT" "### 📊 Status: ⚠️ UNKNOWN"
	assert_file_contains_literal "$GITHUB_OUTPUT" "**Build:** ⚠️ Test counts unreadable"
	assert_file_contains_literal "$GITHUB_OUTPUT" \
		"⚠️ The report's \`stats.unexpected\` value is not a number; see the job log."
	assert_file_contains_literal "$GITHUB_OUTPUT" \
		"⚠️ The report's \`stats.duration\` value is not a number; see the job log."
	run grep -c -e "ordinary label" -e "@org/team" -e "PASSED" -e "| \*\*Total Tests\*\*" "$GITHUB_OUTPUT"
	assert_output "0"
}

@test "generate-playwright-comment: an unreadable duration keeps the table and says so (#1676)" {
	local results_file="${BATS_TEST_TMPDIR}/results.json"
	printf '%s' '{"stats":{"expected":2,"unexpected":0,"flaky":0,"skipped":0,"duration":-5},"suites":[]}' \
		>"$results_file"
	run env GITHUB_OUTPUT="$GITHUB_OUTPUT" RESULTS_PATH="$results_file" \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-playwright-comment.sh"
	assert_success
	assert_file_contains "$GITHUB_OUTPUT" "success=true"
	assert_file_contains_literal "$GITHUB_OUTPUT" "| **Duration** | N/A |"
	assert_file_contains_literal "$GITHUB_OUTPUT" \
		"⚠️ The report's \`stats.duration\` value is not a number; see the job log."
}

@test "generate-playwright-comment: a report with no readable stats is UNKNOWN, never a pass (#1676)" {
	local results_file="${BATS_TEST_TMPDIR}/results.json" report
	for report in 'not json {' '{}' '{"stats":null}' '{"suites":"x"}' '{"stats":{}}' \
		'{"stats":{"expected":3,"unexpected":false,"flaky":0,"skipped":0,"duration":5}}'; do
		printf '%s' "$report" >"$results_file"
		: >"$GITHUB_OUTPUT"
		run env GITHUB_OUTPUT="$GITHUB_OUTPUT" RESULTS_PATH="$results_file" \
			bash "${PROJECT_ROOT}/scripts/ci/actions/generate-playwright-comment.sh"
		assert_success
		assert_file_contains "$GITHUB_OUTPUT" "success=false"
		assert_file_contains_literal "$GITHUB_OUTPUT" "### 📊 Status: ⚠️ UNKNOWN"
		assert_file_contains_literal "$GITHUB_OUTPUT" "value is not a number; see the job log."
		run grep -c -e "PASSED" -e "Tests passed" "$GITHUB_OUTPUT"
		assert_output "0"
	done
}

@test "generate-playwright-comment: a readable report with no tests says NO TESTS, not PASSED (#1676)" {
	local results_file="${BATS_TEST_TMPDIR}/results.json"
	printf '%s' '{"stats":{"expected":0,"unexpected":0,"flaky":0,"skipped":0,"duration":5}}' \
		>"$results_file"
	run env GITHUB_OUTPUT="$GITHUB_OUTPUT" RESULTS_PATH="$results_file" \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-playwright-comment.sh"
	assert_success
	assert_file_contains_literal "$GITHUB_OUTPUT" "### 📊 Status: ⚠️ NO TESTS"
	assert_file_contains_literal "$GITHUB_OUTPUT" "**Build:** ⚠️ No tests ran"
	run grep -c "PASSED" "$GITHUB_OUTPUT"
	assert_output "0"
}

@test "generate-playwright-comment: a test without a recognised status is UNKNOWN, never a pass (#1692)" {
	local results_file="${BATS_TEST_TMPDIR}/results.json" report
	for report in \
		'{"suites":[{"specs":[{"tests":[{"status":"expected"},{"results":[{"status":"failed"}]}]}]}]}' \
		'{"suites":[{"specs":[{"tests":[{"status":"expected"},{"status":"bogus"}]}]}]}' \
		'{"suites":[{"specs":[{"tests":[{"status":"expected"},{"status":["unexpected"]}]}]}]}'; do
		printf '%s' "$report" >"$results_file"
		: >"$GITHUB_OUTPUT"
		run env GITHUB_OUTPUT="$GITHUB_OUTPUT" RESULTS_PATH="$results_file" \
			bash "${PROJECT_ROOT}/scripts/ci/actions/generate-playwright-comment.sh"
		assert_success
		assert_output --partial "::warning::1 test(s) in the Playwright report have no recognised status"
		assert_file_contains "$GITHUB_OUTPUT" "success=false"
		assert_file_contains "$GITHUB_OUTPUT" "total=2"
		assert_file_contains_literal "$GITHUB_OUTPUT" "### 📊 Status: ⚠️ UNKNOWN"
		assert_file_contains_literal "$GITHUB_OUTPUT" \
			"⚠️ 1 test(s) in the report have no recognised \`status\`; see the job log."
		run grep -c -e "PASSED" -e "| \*\*Total Tests\*\*" "$GITHUB_OUTPUT"
		assert_output "0"
	done
}

@test "generate-playwright-comment: every recognised status keeps the suites table (#1692)" {
	local results_file="${BATS_TEST_TMPDIR}/results.json"
	printf '%s' '{"suites":[{"specs":[{"tests":[{"status":"expected"},{"status":"passed"},
		{"status":"skipped"},{"status":"flaky"},{"status":"interrupted"}]}]}]}' >"$results_file"
	run env GITHUB_OUTPUT="$GITHUB_OUTPUT" RESULTS_PATH="$results_file" SHOW_FAILED="false" \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-playwright-comment.sh"
	assert_success
	refute_output --partial "no recognised status"
	assert_file_contains "$GITHUB_OUTPUT" "total=5"
	assert_file_contains "$GITHUB_OUTPUT" "success=false"
	assert_file_contains_literal "$GITHUB_OUTPUT" "| **Total Tests** | 5 |"
}

# Renders one inline report; leaves the outputs in GITHUB_OUTPUT.
render_report() {
	printf '%s' "$1" >"${BATS_TEST_TMPDIR}/results.json"
	: >"$GITHUB_OUTPUT"
	run env GITHUB_OUTPUT="$GITHUB_OUTPUT" RESULTS_PATH="${BATS_TEST_TMPDIR}/results.json" SHOW_FAILED=false \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-playwright-comment.sh"
	assert_success
}

@test "generate-playwright-comment: a spec or suite without readable tests is UNKNOWN, never a pass (#1692)" {
	local report
	for report in \
		'{"suites":[{"specs":[{"tests":[{"status":"expected"}]},{"ok":false,"tests":[]}]}]}' \
		'{"suites":[{"specs":[{"tests":[{"status":"expected"}]},{"ok":false,"tests":[{"results":[]}]}]}]}' \
		'{"suites":[{"specs":[{"tests":[{"status":"expected"}]},{"title":"no tests key"}]}]}' \
		'{"suites":[{"specs":[{"tests":[{"status":"expected"}]},{"tests":null}]}]}' \
		'{"suites":[{"specs":[{"tests":[{"status":"expected"}]},"spec"]}]}' \
		'{"suites":[{"specs":[{"tests":[{"status":"expected"}]}]},{"specs":{"a":1}}]}' \
		'{"suites":[{"specs":[{"tests":[{"status":"expected"}]}],"suites":"nested"}]}' \
		'{"suites":[{"suites":[{"suites":[{"specs":[{"tests":[{"status":"expected"}]},{"ok":false,"tests":[]}]}]}]}]}'; do
		render_report "$report"
		assert_output --partial "suite(s) or spec(s) in the Playwright report have no readable tests"
		assert_file_contains "$GITHUB_OUTPUT" "success=false"
		assert_file_contains_literal "$GITHUB_OUTPUT" "### 📊 Status: ⚠️ UNKNOWN"
		assert_file_contains_literal "$GITHUB_OUTPUT" "in the report have no readable \`tests\`, \`specs\` or \`suites\` list"
		run grep -c "PASSED" "$GITHUB_OUTPUT"
		assert_output "0"
	done
}

@test "generate-playwright-comment: errors outside any test are never PASSED or NO TESTS (#1692)" {
	local report
	for report in \
		'{"errors":[{"message":"globalSetup failed"}],"suites":[{"specs":[{"ok":true,"tests":[{"status":"expected"}]}]}]}' \
		'{"errors":[{"message":"x"}],"stats":{"expected":1,"unexpected":0,"flaky":0,"skipped":0,"duration":5},"suites":[]}' \
		'{"errors":[{"message":"x"}],"suites":[]}'; do
		render_report "$report"
		assert_output --partial "error(s) outside any test"
		assert_file_contains "$GITHUB_OUTPUT" "success=false"
		assert_file_contains_literal "$GITHUB_OUTPUT" "### 📊 Status: ❌ FAILED"
		assert_file_contains_literal "$GITHUB_OUTPUT" "**Build:** ❌ The run reported errors outside any test"
		assert_file_contains_literal "$GITHUB_OUTPUT" "❌ The report lists 1 error(s) outside any test"
		# The error text is report content and stays in the log.
		run grep -c -e "PASSED" -e "NO TESTS" -e "globalSetup failed" "$GITHUB_OUTPUT"
		assert_output "0"
	done
	# Playwright 1.63's "No tests found" run (exit 1) writes exactly this.
	: >"$GITHUB_OUTPUT"
	run env GITHUB_OUTPUT="$GITHUB_OUTPUT" RESULTS_PATH="${PROJECT_ROOT}/tests/fixtures/playwright/reports/json-empty.json" \
		bash "${PROJECT_ROOT}/scripts/ci/actions/generate-playwright-comment.sh"
	assert_success
	assert_file_contains "$GITHUB_OUTPUT" "success=false"
	assert_file_contains_literal "$GITHUB_OUTPUT" "### 📊 Status: ❌ FAILED"
}

@test "generate-playwright-comment: an errors value that is not a list is unreadable (#1692)" {
	render_report '{"errors":"boom","suites":[{"specs":[{"tests":[{"status":"expected"}]}]}]}'
	assert_file_contains "$GITHUB_OUTPUT" "success=false"
	assert_file_contains_literal "$GITHUB_OUTPUT" "### 📊 Status: ⚠️ UNKNOWN"
}

@test "generate-playwright-comment: readable containers, failing tests and an empty errors list read as before (#1692)" {
	render_report '{"errors":[],"suites":[{"specs":[{"ok":true,"tests":[{"status":"expected"}]},{"ok":false,"tests":[{"status":"unexpected"}]}],"suites":[]}]}'
	refute_output --partial "no readable tests"
	assert_file_contains "$GITHUB_OUTPUT" "total=2"
	assert_file_contains_literal "$GITHUB_OUTPUT" "### 📊 Status: ❌ FAILED"
	assert_file_contains_literal "$GITHUB_OUTPUT" "**Build:** ❌ 1 test(s) failed"
	# With --pass-with-no-tests Playwright writes no error: NO TESTS, as before.
	render_report '{"errors":[],"suites":[]}'
	assert_file_contains_literal "$GITHUB_OUTPUT" "### 📊 Status: ⚠️ NO TESTS"
	assert_file_contains "$GITHUB_OUTPUT" "success=true"
}
