#!/usr/bin/env bats
# SPDX-License-Identifier: MIT
# Purpose: Tests for scripts/ci/lib/github/comment_chrome.sh

load "../../../../helpers/common"

setup() {
	setup_temp_dir
	export LIB_DIR
}

teardown() {
	teardown_temp_dir
}

@test "comment_chrome_heading: title only prints just the heading" {
	run bash -c 'source "$LIB_DIR/github/comment_chrome.sh"; comment_chrome_heading "My Title"'
	assert_success
	assert_output "## My Title"
}

@test "comment_chrome_heading: status adds the standard status line" {
	run bash -c 'source "$LIB_DIR/github/comment_chrome.sh"; comment_chrome_heading "T" "✅ PASSED"'
	assert_success
	assert_line --index 0 "## T"
	assert_line --index 1 "### 📊 Status: ✅ PASSED"
	assert_equal "$(bash -c 'source "$LIB_DIR/github/comment_chrome.sh"; comment_chrome_heading "T" "x"' | sed -n 2p)" ""
}

@test "comment_chrome_heading: empty status prints no status line" {
	run bash -c 'source "$LIB_DIR/github/comment_chrome.sh"; comment_chrome_heading "T" ""'
	assert_success
	refute_output --partial "Status:"
}

@test "comment_chrome_heading: title is not interpreted as a format string" {
	run bash -c 'source "$LIB_DIR/github/comment_chrome.sh"; comment_chrome_heading "100% %s \$(id)"'
	assert_success
	assert_output '## 100% %s $(id)'
}

@test "comment_chrome_footer: prints the standard footer" {
	run bash -c 'source "$LIB_DIR/github/comment_chrome.sh"; comment_chrome_footer "file breakdown"'
	assert_success
	assert_output "<sub>Generated by file breakdown workflow</sub>"
}

@test "comment_chrome_footer: defaults the name" {
	run bash -c 'source "$LIB_DIR/github/comment_chrome.sh"; comment_chrome_footer'
	assert_success
	assert_output "<sub>Generated by lgtm-ci workflow</sub>"
}

@test "comment_chrome_result_status: maps each upstream result" {
	run bash -c 'source "$LIB_DIR/github/comment_chrome.sh"; comment_chrome_result_status success'
	assert_output "✅ PASSED"
	run bash -c 'source "$LIB_DIR/github/comment_chrome.sh"; comment_chrome_result_status failure'
	assert_output "❌ FAILED"
	run bash -c 'source "$LIB_DIR/github/comment_chrome.sh"; comment_chrome_result_status cancelled'
	assert_output "⏭️ CANCELLED"
	run bash -c 'source "$LIB_DIR/github/comment_chrome.sh"; comment_chrome_result_status skipped'
	assert_output "⏭️ SKIPPED"
}

@test "comment_chrome_result_status: empty or unknown yields nothing" {
	run bash -c 'source "$LIB_DIR/github/comment_chrome.sh"; comment_chrome_result_status ""'
	assert_success
	assert_output ""
	run bash -c 'source "$LIB_DIR/github/comment_chrome.sh"; comment_chrome_result_status weird'
	assert_success
	assert_output ""
}

@test "comment_chrome: sourcing twice is safe" {
	run bash -c 'source "$LIB_DIR/github/comment_chrome.sh"; source "$LIB_DIR/github/comment_chrome.sh"; comment_chrome_footer x'
	assert_success
}
