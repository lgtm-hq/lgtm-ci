# EditorConfig: https://editorconfig.org (shfmt reads the shell keys below)

# The Trivy installer body is copied verbatim into workflow `run: |` blocks by
# scripts/ci/bootstrap/sync_inline_blocks.py (#1450), so it keeps the
# workflows' two-space style instead of shfmt's tab default.
[scripts/ci/bootstrap/install-verified-trivy.sh]
indent_style = space
indent_size = 2
switch_case_indent = true
space_redirects = true
